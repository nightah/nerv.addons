root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# The GPL text, reproduced with its own alignment.
[{LICENSE,LICENSE.txt}]
indent_size = unset

# Embeds a JavaScript harvester and shell snippets with their own indentation.
[tools/tennistv-headshots/*]
indent_size = unset
